<?xml version="1.0" encoding="utf-8"?>
<!--
    No user data to back up — all state is in Android system settings.
    Exclude everything to keep backups clean.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
